                shadow_steps: 32, multiple_scattering: 0.25)),
            density: 0.80, emission: 1.25, dust: 8.0, scattering: 0.3, anisotropy: 0.35, turbulence: 1.2, detail: 2.5,
            cool_color: (0.018,0.17,0.29), warm_color: (1.0,0.20,0.025),
