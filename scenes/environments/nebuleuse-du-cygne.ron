            (id: 2, kind: Output, name: "Nébuleuse volumétrique", pos: (480.0,0.0), enabled: true),
        ],
        links: [(from: (0,0), to: (1,0)), (from: (1,0), to: (2,0))],
        safety: 1.0, bounding_radius_hint: 1.0,
