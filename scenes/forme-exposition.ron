// « Cathédrale » — a scale-2.2 Mandelbox whose loop folds the point through a
// four-plane kaleidoscope before the sphere fold (Kaléidoscope 4 à 45°), trapped on the
// plane y = 0 (PlaneY) and clipped by a sphere of radius 7: the folds read as a fluted stone column
// carved with ogival arches, a form none of the three closed formulas can produce.
// Lit by a low 3200 K sun raking from the left, a cool 9000 K soft fill from behind-right
// and a thin anisotropic haze; 50 mm at f/4 focused on the front arches.
(
    seed: 11,
    fractal: Graph((
    nodes: [
        (id: 0, kind: Input, name: "Entrée", pos: (0.0, 0.0), enabled: true),
        (id: 1, kind: Iterate(iterations: 10, bailout: 1000.0, body: [2, 3, 4, 5, 6, 7]), name: "Répéter", pos: (240.0, 0.0), enabled: true),
        (id: 2, kind: BoxFold(limit: 1.0), name: "Pli boîte", pos: (240.0, 96.0), enabled: true),
        (id: 3, kind: Kaleido(planes: 4, phase: 45.0), name: "Kaléidoscope", pos: (240.0, 192.0), enabled: true),
        (id: 4, kind: Trap(slot: 0, measure: PlaneY, scale: 2.0), name: "Piège", pos: (240.0, 288.0), enabled: true),
        (id: 5, kind: SphereFold(min_radius: 0.4, fixed_radius: 1.0), name: "Pli sphère", pos: (240.0, 384.0), enabled: true),
        (id: 6, kind: Scale(factor: 2.2), name: "Échelle", pos: (240.0, 480.0), enabled: true),
        (id: 7, kind: AddOrigin, name: "Ajouter l'origine", pos: (240.0, 576.0), enabled: true),
        (id: 8, kind: NormFence(inset: 0.0), name: "Clôture norme", pos: (480.0, 0.0), enabled: true),
        (id: 9, kind: Sphere(radius: 7.0), name: "Sphère", pos: (480.0, 500.0), enabled: true),
        (id: 10, kind: Intersection, name: "Intersection", pos: (720.0, 0.0), enabled: true),
        (id: 11, kind: Output, name: "Sortie", pos: (960.0, 0.0), enabled: true),
    ],
    links: [
        (from: (0, 0), to: (1, 0)),
        (from: (1, 0), to: (8, 0)),
        (from: (0, 0), to: (9, 0)),
        (from: (8, 0), to: (10, 0)),
        (from: (9, 0), to: (10, 1)),
        (from: (10, 0), to: (11, 0)),
    ],
    safety: 0.5,
    bounding_radius_hint: 8.0,
)),
    camera: (
        mode: Orbit(
            point: (0.0, 0.4, 0.0),
            distance: 13.0,
            azimuth: 24.0,
            elevation: 9.0,
            roll: -2.0,
        ),
        focal_mm: 50.0,
        f_number: 4.0,
        focus_distance: 11.5,
    ),
    lights: [
        Sun(
            direction: (-0.75, 0.25, 0.60),
            color: Kelvin(3200.0),
            intensity: 9.0,
            angular_size: 0.55,
        ),
        Area(
            position: (4.0, 3.0, -5.0),
            normal: (-0.6, -0.4, 0.7),
            size: (4.0, 3.0),
            color: Kelvin(9000.0),
            intensity: 4.0,
        ),
        Environment(
            zenith: Linear((0.15, 0.28, 0.6)),
            horizon: Linear((0.7, 0.66, 0.62)),
            ground: Linear((0.12, 0.1, 0.09)),
            intensity: 0.6,
            rotation: 0.0,
        ),
    ],
    // Pale limestone: the Y-axis trap darkens the recesses and lightens the ridges.
    material: (
        albedo: (0.78, 0.74, 0.66),
        roughness: 0.55,
        metallic: 0.0,
        specular: 0.04,
        coloring: Trap(
            slot: 0,
            ramp: (
                stops: [
                    (0.35, 0.30, 0.26),
                    (0.80, 0.74, 0.64),
                    (0.92, 0.90, 0.86),
                ],
            ),
        ),
    ),
    atmosphere: (
        fog_density: 0.018,
        fog_color: (0.82, 0.76, 0.68),
        fog_height: -1.0,
        fog_falloff: 0.35,
        anisotropy: 0.75,
        cavity_darkness: 0.35,
    ),
    look: (
        exposure_ev: 0.0,
        auto_exposure: Some(0.18),
        temperature: 5400.0,
        tint: 0.0,
        shadows: (offset: (0.0, 0.004, 0.014), gain: 0.0),
        midtones: (offset: (0.0, 0.0, 0.0), gain: 0.0),
        highlights: (offset: (0.012, 0.006, 0.0), gain: 0.0),
        tonemap: Agx(slope: 1.0, power: 1.15, offset: 0.0),
        saturation: 1.0,
        vibrance: 0.2,
        vignette: Some((radius: 0.7, softness: 0.9, intensity: 0.3, elliptical: true)),
        grain: Some((amount: 0.02, size: 1.0, seed: 3)),
        output: Srgb,
        dither: true,
    ),
)
